[Unit]
Description=Open Station setup page for hotspot clients
After=vipercoma-wifi.service
[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/vipercoma-wifi-portal.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
[Install]
WantedBy=multi-user.target
